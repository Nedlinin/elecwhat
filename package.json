  },
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.9",
    "consola": "^3.4.2",
    "electron-context-menu": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "sharp": "^0.35.5"
  }
